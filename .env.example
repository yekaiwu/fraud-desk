# GLDB document-fraud analysis tool: every setting, with its default. Copy to .env to override.
# No secrets are committed. All data is fictitious.

# --- storage ---------------------------------------------------------------------------
GLDB_DATA_DIR=./data
# defaults to <DATA_DIR>/gldb.sqlite3 ; ":memory:" is allowed in tests
GLDB_DB_PATH=
GLDB_REGISTRY_PATH=./samples/registry.json
# Look an applicant UEN that the file does not hold up in Singapore's open ACRA data (data.gov.sg; docs/checks-kyc-aml.md 4.5a)
GLDB_REGISTRY_LIVE=false
# Private mode (docs/local-llm.md section 12): off | on. "on" refuses to start with a hosted model or key
# (GLDB_ANTHROPIC_API_KEY, an OpenRouter-style GLDB_LLM_BASE_URL), accepts only a loopback, private or tailnet LLM host
# (or one listed below), switches off the live register lookup and every other outbound call, and refuses
# Telegram, external webhook and external SMTP alert sinks. Reported in GET /monitoring and in the case provenance.
GLDB_PRIVATE_MODE=off
# comma-separated hosts (names or IPs) that private mode accepts in addition to loopback / private / tailnet ranges
GLDB_PRIVATE_ALLOWED_HOSTS=

# --- external verification sources (docs/verification-sources.md) ------------------------
# All off by default. A source that is not configured is a skipped check that does NOT lower coverage;
# one that is configured but cannot be reached marks the case partial and is never a flag.
# GLDB_PRIVATE_MODE=on (when that setting is present in your build) blocks every one that opens a connection.
# Screen the applicant, directors, owners and named counterparties against a local snapshot of the OFFICIAL
# sanctions lists (UN, OFAC, EU, UK). Build the snapshot first: uv run python backend/scripts/update_sanctions.py
# A possible match is a reason for a person to look, never a decision. A snapshot older than the limit = check not run.
GLDB_SANCTIONS_SCREEN=off
# empty = <DATA_DIR>/sanctions/current.json
GLDB_SANCTIONS_SNAPSHOT=
GLDB_SANCTIONS_MAX_AGE_DAYS=7
# GLEIF legal-entity lookup by UEN or name (api.gleif.org, no key). Context and low/medium flags only.
GLDB_GLEIF=off
# OneMap (SLA) postal code and address check. A free token from developers.onemap.sg (it expires in days),
# or the account email and password, from which the token is fetched and renewed. Neither set = check off.
# secret: never commit, never log
GLDB_ONEMAP_TOKEN=
GLDB_ONEMAP_EMAIL=
# secret: never commit, never log
GLDB_ONEMAP_PASSWORD=
# IRAS "Check GST Register" (API Marketplace). Built from the public documentation; access terms unconfirmed
# and never run live by this project. Off without a key.
# secret: never commit, never log
GLDB_IRAS_API_KEY=
# secret: never commit, never log
GLDB_IRAS_API_SECRET=
GLDB_IRAS_BASE_URL=https://apiservices.iras.gov.sg/iras/prod
# total seconds one case may spend asking these sources
GLDB_SOURCES_BUDGET_S=45
# ISO date used as case.today for new cases (demos, tests). Empty = wall-clock date at creation.
GLDB_TODAY=

# --- encryption at rest (docs/encryption-at-rest.md) -----------------------------------
# off | on. "on" makes the APPLICATION encrypt files, page renders, case bodies, review entries and the
# response cache with AES-256-GCM, whatever the disk does. With "on" and no usable key the backend refuses
# to start (it never falls back to plaintext). Existing plaintext data still reads; encrypt it with
# backend/scripts/encrypt_data.py (back up first).
GLDB_ENCRYPT_AT_REST=off
# Keys as id:base64(32 bytes), comma separated. The FIRST is used for new writes, all can decrypt (rotation).
# Make one with: python3 -c "import os,base64;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
# secret: never commit, never log. Prefer the key file below (a path, not the key, goes in the environment).
GLDB_ENCRYPTION_KEYS=
# A file with the same "id:base64" lines (mode 0600, OUTSIDE the data directory and outside its backups).
GLDB_ENCRYPTION_KEY_FILE=

# --- LLM (OpenAI-compatible API; the Fake client is used when no key is set) ------------
# auto (anthropic/Haiku if GLDB_ANTHROPIC_API_KEY is set, else openai if GLDB_LLM_API_KEY is set, else fake)
# | fake | openai (e.g. the local Qwen: set it explicitly, it overrides a configured Haiku key) | anthropic
GLDB_LLM_BACKEND=auto
GLDB_LLM_BASE_URL=https://openrouter.ai/api/v1
# secret: never commit, never log
GLDB_LLM_API_KEY=
# required when the backend is openai
GLDB_LLM_MODEL_CHEAP=
GLDB_LLM_MODEL_STRONG=
# raise to 300 for the local server: a long page can queue behind another request
GLDB_LLM_TIMEOUT_S=60
GLDB_LLM_SCHEMA_RETRIES=1
# Local / self-hosted server knobs (docs/local-llm.md). The defaults below are the hosted behaviour.
# true: let the model think (slower, may be better); false: send chat_template_kwargs.enable_thinking=false
GLDB_LLM_ENABLE_THINKING=true
# non-empty: also send the OpenAI-style reasoning_effort field. LM Studio ignores the line above but honours "none".
GLDB_LLM_REASONING_EFFORT=
# With GLDB_LLM_ENABLE_THINKING=false and the line above empty, "none" is sent anyway (LM Studio would otherwise keep thinking).
# true: tables come back as lists of rows (about a fifth fewer output tokens on a statement page). Local profile.
GLDB_LLM_COMPACT_TABLES=false
# false for a text-only model: no image is ever sent; scans are read by local OCR (GLDB_OCR_BACKEND)
GLDB_LLM_SUPPORTS_VISION=true
# Anthropic backend with a local OCR (GLDB_OCR_BACKEND=tesseract|rapidocr|vision): the model reads OCR text, and a scanned page whose
# arithmetic fails is re-read once from its image. Defaults to true in that setup; false = no image ever leaves the machine.
# empty = on in that setup, off elsewhere
GLDB_LLM_VISION_FALLBACK=
# A flag on scanned pages must be reproduced by a second, different reading of those pages
# (Tesseract text <-> the model reading images). Empty = on under the anthropic backend.
GLDB_VERIFY_SCAN_FLAGS=
# Review team (docs/agents.md): a challenger may lower a judgement flag when it can quote the
# documents' own explanation, and a case officer writes the summary. Empty = on under anthropic.
GLDB_AGENTS=
# Delete expired closed cases on a schedule (GLDB_RETENTION_DAYS, default 1825) instead of only when the purge
# endpoint is called. Escalated cases are never purged automatically. Off by default.
GLDB_RETENTION_AUTO=false
GLDB_RETENTION_INTERVAL_HOURS=24
# Monitoring (docs/ai-incidents.md): the person accountable for the AI system, and the limits GET /monitoring
# compares the last window of cases against.
GLDB_AI_OWNER=
GLDB_MONITOR_WINDOW_DAYS=7
GLDB_MONITOR_MIN_CASES=10
GLDB_MONITOR_PARTIAL_RATE_MAX=0.30
GLDB_MONITOR_CHECK_ERROR_RATE_MAX=0.05
GLDB_MONITOR_AGENT_FAILURE_RATE_MAX=0.10
GLDB_MONITOR_DAILY_SPEND_RATIO_MAX=0.80
GLDB_MONITOR_RULE_DRIFT_MAX=0.25
# Who gets told, and does the monitor run? (docs/ai-incidents.md). Everything here is off or empty until the bank
# decides. 0 = nothing evaluates by itself; set e.g. 15 for every 15 minutes in this process, or leave 0 and run
# backend/scripts/monitor_once.py from the bank's own scheduler (then set the interval here to match it and
# GLDB_MONITOR_IN_PROCESS=false, so the silence check watches that scheduler).
GLDB_MONITOR_INTERVAL_MINUTES=0
GLDB_MONITOR_IN_PROCESS=true
# Alert sinks, each optional. A failing sink never blocks the others. These values are secrets: keep them in
# the real .env only.
# 1) JSON webhook (Slack / Teams incoming webhook, or any receiver). With a secret the body is signed:
#    X-Gldb-Signature: sha256=<hex hmac-sha256 of the raw body>
GLDB_ALERT_WEBHOOK_URL=
GLDB_ALERT_WEBHOOK_SECRET=
# 2) E-mail over SMTP (STARTTLS on by default; port 465 uses TLS from the start). To is comma-separated.
GLDB_ALERT_SMTP_HOST=
GLDB_ALERT_SMTP_PORT=587
GLDB_ALERT_SMTP_STARTTLS=true
GLDB_ALERT_SMTP_USER=
GLDB_ALERT_SMTP_PASSWORD=
GLDB_ALERT_EMAIL_FROM=
GLDB_ALERT_EMAIL_TO=
# 3) Telegram bot: token from @BotFather and the chat id to write to
GLDB_ALERT_TELEGRAM_BOT_TOKEN=
GLDB_ALERT_TELEGRAM_CHAT_ID=
# 4) Local append-only JSON lines file, the last resort (a record, not a way to tell anyone)
GLDB_ALERT_FILE_PATH=
GLDB_ALERT_TIMEOUT_S=8
GLDB_ALERT_RETRIES=3
GLDB_ALERT_RETRY_BACKOFF_S=1
# An open alert nobody acknowledged is sent again after this many hours
GLDB_ALERT_RENOTIFY_HOURS=24
# Readiness 5.23(c) needs a delivered test alert (POST /monitoring/alerts/test) no older than this
GLDB_ALERT_TEST_MAX_AGE_DAYS=30
# Shown in messages as the address of GET /monitoring, e.g. https://fraud.bank.example/api
GLDB_ALERT_BASE_URL=
# true when every person signs in with a personal account (GLDB_SITE_USERS on the front): acknowledging an alert
# or approving thresholds then needs that account, not a typed name
GLDB_PERSONAL_ACCOUNTS=false
# max simultaneous model calls, shared by all page workers; 1 for a server that runs one request at a time
GLDB_LLM_MAX_CONCURRENCY=4
# max_tokens per call; use 16000 or more with thinking on
GLDB_LLM_MAX_OUTPUT_TOKENS=8000
# retries of a 503 (model loading); waits Retry-After if sent, else BACKOFF_S * 3**n, never above MAX_WAIT_S.
# A "server is stopped" 503 is re-checked once and then fails with the Telegram /start instruction.
GLDB_LLM_RETRY_503_ATTEMPTS=2
GLDB_LLM_RETRY_503_BACKOFF_S=1
GLDB_LLM_RETRY_503_MAX_WAIT_S=60
# local OCR for scanned pages when the model has no vision: auto | vision | none
# auto = macOS Vision via ocrmac when installed (uv sync --extra ocr), else none. With a vision model
# (SUPPORTS_VISION=true) auto/none keep reading scans with the model; vision forces local OCR.
# auto | vision (Apple) | tesseract (needs: brew install tesseract) | none
GLDB_OCR_BACKEND=auto
# opt in: find the page in a phone photo and straighten it before a local OCR reads it (docs/ingest-and-extraction.md 4.8); off because it did not help end to end
GLDB_OCR_STRAIGHTEN=false
# opt in: a second, different OCR (macOS Vision, Tesseract or RapidOCR, whichever is not the first reader) reads every photographed or scanned page on this machine (free, about 0.2-2 s a page). A money, date or ID figure the two print differently is marked unverified, and a check that fails only on such a figure is lowered to "reading unreliable, check the page image by eye" and counted in coverage and partial reasons. Agreement never lowers anything (docs/ingest-and-extraction.md 4.12, docs/limitations.md section 13)
GLDB_MULTI_READER=false
# true: read a scanned document with the deterministic parsers first (on its OCR words); the model is called only when the
# parser does not recognise the layout, a required field is missing or an arithmetic check fails. Local profile (docs/local-llm.md 12).
GLDB_SCAN_RULES_FIRST=false
# JSON {model: {"input_per_mtok": "0.15", "output_per_mtok": "0.60", "cached_input_per_mtok": "0.015"}}
GLDB_PRICES_PATH=

# --- Anthropic backend (docs/anthropic-haiku.md): official SDK, Claude Haiku 5.5 only --------------
# With the key set, auto selects this backend (the default model); force it with GLDB_LLM_BACKEND=anthropic. Paid: page text and images leave the
# machine to Anthropic, so fictitious documents only. Put the real key in .env (gitignored), never here.
GLDB_ANTHROPIC_API_KEY=
# the only value accepted; anything else stops the application at start-up
GLDB_ANTHROPIC_MODEL=claude-haiku-5-5
# required when the key is user-scoped (the API then wants the anthropic-workspace-id header); see the doc
GLDB_ANTHROPIC_WORKSPACE_ID=
GLDB_ANTHROPIC_TIMEOUT_S=120
# paid backends (anthropic, openai) only: all cases together per UTC day; 0 disables
GLDB_MAX_USD_PER_DAY=5.00
# One signed-in account's own share of the day (analyses it starts); 0 disables
GLDB_MAX_USD_PER_USER_PER_DAY=0

# --- local OpenAI-compatible server profile (uncomment and paste into .env; replaces the LLM block above) ---------
# Needs: Tailscale signed in to the tailnet of the machine running the server, the server started (send /start to the Telegram
# bot @your_llm_gateway_bot), and a key from `/newkey gldb 30` in the same chat. Text-only model:
# scans are read by macOS Vision OCR, so run `uv sync --extra ocr` first. Prices are built in
# ("local, $0 marginal cost"); no GLDB_PRICES_PATH needed.
# GLDB_LLM_BACKEND=openai
# GLDB_LLM_BASE_URL=http://llm-host:8080/v1
# GLDB_LLM_API_KEY=sk-llm-...paste-the-key-here
# GLDB_LLM_MODEL_CHEAP=qwen3.8-27b
# GLDB_LLM_MODEL_STRONG=qwen3.8-27b
# GLDB_LLM_TIMEOUT_S=300
# GLDB_LLM_ENABLE_THINKING=false
# GLDB_LLM_REASONING_EFFORT=none
# GLDB_LLM_SUPPORTS_VISION=false
# GLDB_LLM_MAX_CONCURRENCY=1
# GLDB_LLM_MAX_OUTPUT_TOKENS=8000
# GLDB_LLM_RETRY_503_ATTEMPTS=8
# GLDB_LLM_RETRY_503_BACKOFF_S=5
# GLDB_OCR_BACKEND=auto
# GLDB_EXTRACTOR_MODE=cascade
# GLDB_CLASSIFIER_MODE=rules
# GLDB_MAX_PAGE_WORKERS=1

# --- semantic signals (docs/semantic-signals.md) --------------------------------------
# on | off. Model-derived checks that quote the extracted data. Empty = on whenever a model is
# configured (anthropic or openai) and off with the fake backend; off changes nothing.
GLDB_SEMANTIC=
GLDB_SEMANTIC_MAX_CLAIMS=8
# on | off. The model-based name-linking check (sem_entity_link) has its own switch and is OFF by
# default: it fails the fairness rule (docs/semantic-signals.md invariant 6) and stays off until the
# gap between name groups is closed and the bank agrees. It runs only if GLDB_SEMANTIC is on as well.
GLDB_SEMANTIC_ENTITY=off

# --- risk score model (docs/scoring-and-queue.md section 4.4a) ------------------------
# legacy | calibrated. legacy = the original rule, min(100, sum of finding points). calibrated =
# each finding gets a probability from a fitted weights file and findings are combined as a
# noisy-OR with a cap per rule family, so four high findings no longer look like eight. Bands,
# hard stops, the fast lane and the partial-case rule are the same under both. The score orders
# the queue; it is not a probability of fraud, and the shipped weights were fitted on synthetic data.
GLDB_SCORE_MODEL=legacy
# Weights file for the calibrated model (written by backend/scripts/fit_score_weights.py).
# Empty = the file shipped with the app (fitted on synthetic data). A missing or invalid file
# stops start-up and scoring; there is no silent fallback.
GLDB_SCORE_WEIGHTS_PATH=

# --- modes and thresholds -------------------------------------------------------------
# text_layer | llm | cascade
GLDB_EXTRACTOR_MODE=cascade
# rules | local | llm | cascade
GLDB_CLASSIFIER_MODE=rules
GLDB_CLASSIFIER_MIN_PROB=0.70
GLDB_LOCAL_CLASSIFIER_MODEL=
# auto | cpu | mps | cuda
GLDB_LOCAL_CLASSIFIER_DEVICE=auto
# beneficial-owner threshold [confirm against Notice 626]
GLDB_UBO_THRESHOLD_PERCENT=25.00
GLDB_MONEY_TOLERANCE=1.00

# --- rendering --------------------------------------------------------------------------
GLDB_RENDER_DPI=150
GLDB_VISION_DPI=150

# --- limits and budget guard (all must be > 0) -------------------------------------------
GLDB_MAX_UPLOAD_MB=25
GLDB_MAX_FILES_PER_CASE=40
GLDB_MAX_PAGES_PER_CASE=200
GLDB_MAX_LLM_CALLS_PER_CASE=100
GLDB_MAX_USD_PER_CASE=2.00
# with the anthropic backend a lower value such as 0.25 is plenty (docs/anthropic-haiku.md)
GLDB_MAX_PAGE_WORKERS=4
GLDB_JOB_WORKERS=2
GLDB_CACHE_ENABLED=true

# --- review and retention -----------------------------------------------------------------
GLDB_REQUIRE_SECOND_APPROVER=true
# 5 years [confirm against Notice 626]
GLDB_RETENTION_DAYS=1825
GLDB_PSEUDONYMISE_LOGS=true
GLDB_LOG_LEVEL=INFO
# comma-separated
GLDB_CORS_ORIGINS=http://localhost:3000

# --- frontend (read by Next.js, not by the backend) ---------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 1 = mock-data mode (npm run dev:mock)
NEXT_PUBLIC_USE_MOCK=0
