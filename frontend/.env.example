# Local development: the browser talks to the backend directly. Default shown.
# A production build (npm run build && npm run start) defaults to "/api", the same-origin proxy that
# forwards to the backend; set this only to override (docs/deploy.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Set to 1 for mock-data mode: the UI runs without the backend (npm run dev:mock).
NEXT_PUBLIC_USE_MOCK=

# --- Server-side only (never NEXT_PUBLIC_): access gate and proxy. See ../deploy/env.production.example ---
# Leave GLDB_SITE_PASSWORD and GLDB_SESSION_SECRET both unset in `npm run dev` for no login.
# In production they are required (12 / 32+ characters) or the server answers 503 to everything.
# GLDB_SITE_PASSWORD=
# GLDB_SESSION_SECRET=
# GLDB_BACKEND_URL=http://127.0.0.1:8000
# GLDB_PROXY_SECRET=
