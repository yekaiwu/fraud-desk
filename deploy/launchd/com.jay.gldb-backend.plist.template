<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: deploy/install.sh fills __ROOT__ (install dir), __HOME__ and __PATH__ and writes the result to
     ~/Library/LaunchAgents/com.jay.gldb-backend.plist. Do not load this file directly. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.gldb-backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/deploy/run-backend.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/gldb/backend.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/gldb/backend.log</string>
</dict>
</plist>
