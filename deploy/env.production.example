# Production environment for a self-hosted deployment (docs/deploy.md).
# deploy/install.sh creates deploy/.env.production from this list with generated secrets if the file is
# missing. Both launchd agents read it (deploy/run-backend.sh, deploy/run-frontend.sh), so it is the
# single place to change settings. Never commit the real file (it is gitignored: .env.*).
# Format: KEY=value, one per line, no spaces around "=", quote values that contain spaces or $ or #.

# --- Access gate (frontend; required, the frontend answers 503 to everything without them) -----
# The account people sign in with on the login page. Username: at least 3 characters (not case-sensitive).
# Password: at least 12 characters. Changing either one signs everybody out.
GLDB_SITE_USERNAME=officer
GLDB_SITE_PASSWORD=change-me-at-least-12-characters
# Signs the 12 h session cookie: at least 32 random characters. Changing it (or the password) signs everyone out.
GLDB_SESSION_SECRET=generate-with-openssl-rand-hex-32

# --- Frontend -> backend hop -----------------------------------------------------------------------
# Shared secret the Next proxy sends as X-Gldb-Proxy-Secret; the backend rejects requests without it
# (401) except GET /health from loopback. At least 16 characters.
GLDB_PROXY_SECRET=generate-with-openssl-rand-hex-32
# Where the Next proxy reaches the backend. Keep it on loopback.
GLDB_BACKEND_URL=http://127.0.0.1:8000

# --- Backend abuse limits (all optional; 0 disables a limit) ------------------------------------------
GLDB_RATE_CASES_PER_HOUR=10
GLDB_RATE_REVIEWS_PER_MIN=30
# Analysis jobs queued or running at once, across everybody (503 "busy" beyond it)
GLDB_MAX_ACTIVE_JOBS=6

# --- Backend data (absolute paths: the agents start from the install directory) ------------------------
# install.sh rewrites these two lines to the install location when it generates this file.
GLDB_DATA_DIR=/Users/CHANGE_ME/.local/gldb-fraud/data
GLDB_REGISTRY_PATH=/Users/CHANGE_ME/.local/gldb-fraud/samples/registry.json
GLDB_CORS_ORIGINS=http://127.0.0.1:3000

# --- LLM ---------------------------------------------------------------------------------------------
# Without a key the backend uses the Fake client: scanned pages are reported unreadable (README, "Honest
# limits"). To use the local model on this machine, copy the local-LLM profile that .env.example (repo
# root) and docs/local-llm.md describe: GLDB_LLM_BASE_URL, GLDB_LLM_API_KEY, GLDB_LLM_MODEL_CHEAP,
# GLDB_LLM_MODEL_STRONG, GLDB_LLM_BACKEND=openai. The LLM gateway stays on localhost; nothing about it
# is exposed. Example shape (values come from that profile, not from here):
#   GLDB_LLM_BACKEND=openai
#   GLDB_LLM_BASE_URL=http://127.0.0.1:8080/v1
#   GLDB_LLM_API_KEY=local
#   GLDB_LLM_MODEL_CHEAP=<model name as the gateway lists it>
#   GLDB_LLM_MODEL_STRONG=<model name as the gateway lists it>
# Paid Anthropic backend (docs/anthropic-haiku.md), Claude Haiku 5.5 only. Type the key into
# deploy/.env.production by hand on this machine: rsync never copies .env files. Fictitious documents only.
#   GLDB_LLM_BACKEND=anthropic
#   GLDB_ANTHROPIC_API_KEY=<paste on the Studio>
#   GLDB_ANTHROPIC_WORKSPACE_ID=<wrkspc_... id>
#   GLDB_MAX_USD_PER_CASE=0.25
#   GLDB_MAX_USD_PER_DAY=5.00
